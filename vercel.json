{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "other",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm --prefix backend install && npm --prefix frontend install",
  "trailingSlash": false,
  "functions": {
    "api/[[...path]].ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
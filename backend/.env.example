# Backend Express (serverless). Untuk lokal saja — jangan pernah commit nilai aslinya.
# Salin ke backend/.env saat menjalankan `npm run dev` di backend/.
# DATABASE_URL = Session pooler (port 5432) dari dashboard Supabase → Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=no-verify
PORT=3001
CORS_ORIGIN=http://localhost:5173

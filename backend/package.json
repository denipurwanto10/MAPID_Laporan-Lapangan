{
  "name": "laporan-lapangan-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API pengelolaan laporan lapangan (Express + TypeScript + PostgreSQL)",
  "main": "dist/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.0",
    "oxlint": "^1.87.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
